PORT=4000

# NeonDB connection string — set your real value in Vercel env settings
# and in your local server/.env (which is gitignored).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret for signing auth tokens — use a long random string
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS origin for the Vite dev server
CLIENT_ORIGIN=http://localhost:5173
